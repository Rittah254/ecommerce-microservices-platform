{
  "info": {
    "name": "E-Commerce Microservices API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "productId",
      "value": "1"
    },
    {
      "key": "orderId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "1 Create Product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productName\": \"Samsung Galaxy S25\",\n  \"productCode\": \"SAM-S25-256\",\n  \"description\": \"Samsung Galaxy smartphone\",\n  \"category\": \"Mobile\",\n  \"brand\": \"Samsung\",\n  \"price\": 79999,\n  \"discountPercentage\": 10,\n  \"taxPercentage\": 18,\n  \"status\": \"ACTIVE\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ]
        }
      }
    },
    {
      "name": "2 Get Products",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/products?page=0&size=10&sort=price,asc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ],
          "query": [
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "size",
              "value": "10"
            },
            {
              "key": "sort",
              "value": "price,asc"
            }
          ]
        }
      }
    },
    {
      "name": "3 Search Product",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/products/search?name=Samsung",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products",
            "search"
          ],
          "query": [
            {
              "key": "name",
              "value": "Samsung"
            }
          ]
        }
      }
    },
    {
      "name": "4 Create Inventory",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": 1,\n  \"availableQuantity\": 25,\n  \"reservedQuantity\": 0,\n  \"reorderLevel\": 5,\n  \"warehouseCode\": \"WH-OKC\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/inventory",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "inventory"
          ]
        }
      }
    },
    {
      "name": "5 Check Inventory",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/inventory/1/availability",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "inventory",
            "1",
            "availability"
          ]
        }
      }
    },
    {
      "name": "6 Create Order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "ORD-REQUEST-10001"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": 1001,\n  \"items\": [\n    {\n      \"productId\": 1,\n      \"quantity\": 2\n    }\n  ],\n  \"shippingAddress\": \"100 Main Street\",\n  \"city\": \"Oklahoma City\",\n  \"state\": \"Oklahoma\",\n  \"postalCode\": \"73102\",\n  \"paymentMethod\": \"CARD\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/orders",
          "host": [
            "{{baseUrl}}",
            ""
          ],
          "path": [
            "api",
            "orders"
          ]
        }
      }
    },
    {
      "name": "7 Get Order",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/orders/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders",
            "1"
          ]
        }
      }
    },
    {
      "name": "8 Check Inventory Again",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/inventory/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "inventory",
            "1"
          ]
        }
      }
    },
    {
      "name": "9 Update Order Status",
      "request": {
        "method": "PUT",
        "url": {
          "raw": "{{baseUrl}}/api/orders/1/status?status=CONFIRMED",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders",
            "1",
            "status"
          ],
          "query": [
            {
              "key": "status",
              "value": "CONFIRMED"
            }
          ]
        }
      }
    },
    {
      "name": "10 Customer Orders",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/orders/customer/1001?page=0&size=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders",
            "customer",
            "1001"
          ],
          "query": [
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "size",
              "value": "10"
            }
          ]
        }
      }
    }
  ]
}